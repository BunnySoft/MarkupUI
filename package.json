{
  "name": "@dataengine/markup-ui",
  "version": "0.11.0",
  "description": "Dependency-free browser-native MarkupUI Web Components",
  "type": "module",
  "main": "./dist/markup-ui.js",
  "module": "./dist/markup-ui.js",
  "unpkg": "./dist/markup-ui.global.js",
  "jsdelivr": "./dist/markup-ui.global.js",
  "types": "./dist/index.d.ts",
  "sideEffects": true,
  "exports": {
    "./popconfirm": {
      "types": "./dist/components/popconfirm/index.d.ts",
      "import": "./dist/markup-ui-popconfirm.js"
    },
    "./popconfirm/style.css": "./dist/markup-ui-popconfirm.css",
    "./tooltip": {
      "types": "./dist/components/tooltip/index.d.ts",
      "import": "./dist/markup-ui-tooltip.js"
    },
    "./tooltip/style.css": "./dist/markup-ui-tooltip.css",
    "./popover": {
      "types": "./dist/components/popover/index.d.ts",
      "import": "./dist/markup-ui-popover.js"
    },
    "./popover/style.css": "./dist/markup-ui-popover.css",
    "./image": {
      "types": "./dist/components/image/index.d.ts",
      "import": "./dist/markup-ui-image.js"
    },
    "./image/style.css": "./dist/markup-ui-image.css",
    "./float-button/style.css": "./dist/markup-ui-float-button.css",
    "./scrollbar/style.css": "./dist/markup-ui-scrollbar.css",
    "./code/style.css": "./dist/markup-ui-code.css",
    "./result/style.css": "./dist/markup-ui-result.css",
    "./affix/style.css": "./dist/markup-ui-affix.css",
    "./highlight": {
      "types": "./dist/components/highlight/index.d.ts",
      "import": "./dist/markup-ui-highlight.js"
    },
    "./highlight/style.css": "./dist/markup-ui-highlight.css",
    "./table/style.css": "./dist/markup-ui-table.css",
    "./thing/style.css": "./dist/markup-ui-thing.css",
    "./breadcrumb/style.css": "./dist/markup-ui-breadcrumb.css",
    "./timeline/style.css": "./dist/markup-ui-timeline.css",
    "./descriptions/style.css": "./dist/markup-ui-descriptions.css",
    "./list/style.css": "./dist/markup-ui-list.css",
    "./layout/style.css": "./dist/markup-ui-layout.css",
    "./grid/style.css": "./dist/markup-ui-grid.css",
    "./space/style.css": "./dist/markup-ui-space.css",
    "./flex/style.css": "./dist/markup-ui-flex.css",
    "./divider/style.css": "./dist/markup-ui-divider.css",
    "./page-header/style.css": "./dist/markup-ui-page-header.css",
