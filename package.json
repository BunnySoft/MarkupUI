{
  "name": "@dataengine/markup-ui",
  "version": "0.11.0",
  "description": "Dependency-free browser-native MarkupUI Web Components",
  "type": "module",
  "main": "./dist/markup-ui.js",
  "module": "./dist/markup-ui.js",
  "unpkg": "./dist/markup-ui.global.js",
  "jsdelivr": "./dist/markup-ui.global.js",
  "types": "./dist/index.d.ts",
  "sideEffects": true,
  "exports": {
    "./alert": {
      "types": "./dist/components/alert/index.d.ts",
      "import": "./dist/markup-ui-alert.js"
    },
    "./alert/style.css": "./dist/markup-ui-alert.css",
    "./badge": {
      "types": "./dist/components/badge/index.d.ts",
      "import": "./dist/markup-ui-badge.js"
    },
    "./badge/style.css": "./dist/markup-ui-badge.css",
    "./tag": {
      "types": "./dist/components/tag/index.d.ts",
      "import": "./dist/markup-ui-tag.js"
    },
    "./tag/style.css": "./dist/markup-ui-tag.css",
    "./card": {
      "types": "./dist/components/card/index.d.ts",
      "import": "./dist/markup-ui-card.js"
    },
    "./card/style.css": "./dist/markup-ui-card.css",
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/markup-ui-button.js"
    },
    "./button/style.css": "./dist/markup-ui-button.css",
    "./avatar": {
      "types": "./dist/components/avatar/index.d.ts",
      "import": "./dist/markup-ui-avatar.js"
    },
    "./avatar/style.css": "./dist/markup-ui-avatar.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/markup-ui.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.js"
    },
    "./advanced": {
      "types": "./dist/plugins/advanced.d.ts",
      "import": "./dist/markup-ui-advanced.js"
    },
    "./widgets": {
      "types": "./dist/plugins/widgets.d.ts",
      "import": "./dist/markup-ui-widgets.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "web-components",
    "custom-elements",
    "ui",
    "html-first",
    "dependency-free",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BunnySoft/MarkupUI.git"
  },
  "homepage": "https://github.com/BunnySoft/MarkupUI",
  "bugs": {
    "url": "https://github.com/BunnySoft/MarkupUI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm build && pnpm test",
    "demo": "node demo/server.mjs",
    "prepare": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
